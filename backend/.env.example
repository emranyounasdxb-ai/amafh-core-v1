AMAFH_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
AMAFH_PUBLIC_ORIGIN=https://amafhcore.com
AMAFH_ENVIRONMENT=production

# Operational backup command only: python -m app.backup_command backup
# Configure these outside source control before running it. The OAuth JSON
# must be an Owner-authorized Drive credential with full Drive scope; the key
# file contains exactly 32 random raw bytes. On Linux both files require 0600,
# and the private media/temporary directories require 0700. Use PostgreSQL 18
# pg_dump and pg_restore absolute executable paths.
# AMAFH_MEDIA_STORAGE_ROOT=/absolute/private/media
# AMAFH_BACKUP_TEMP_ROOT=/absolute/private/temporary
# AMAFH_BACKUP_KEY_FILE=/absolute/private/backup-key
# AMAFH_BACKUP_KEY_ID=owner-key-version-1
# AMAFH_BACKUP_DRIVE_OAUTH_FILE=/absolute/private/owner-oauth.json
# AMAFH_BACKUP_OWNER_EMAIL=owner@example.com
# AMAFH_BACKUP_DRIVE_FOLDER_ID=OWNER_PRIVATE_FOLDER_ID
# AMAFH_BACKUP_PG_DUMP=/absolute/postgresql-18/bin/pg_dump
# AMAFH_BACKUP_PG_RESTORE=/absolute/postgresql-18/bin/pg_restore
# Verify only: python -m app.backup_command restore --set-id UUID
# Restore verification does not require the original database or media path to exist.
# Apply to a distinct empty database and unused media path only:
# AMAFH_BACKUP_RESTORE_DATABASE_URL=postgresql+psycopg://...
# AMAFH_BACKUP_RESTORE_MEDIA_ROOT=/absolute/unused/media
# python -m app.backup_command restore --set-id UUID --apply --confirm-set-id UUID
